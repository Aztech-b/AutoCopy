{
  "manifest_version": 3,
  "name": "Auto Page Copy",
  "version": "1.0.0",
  "description": "Automatically copies webpage text, including dynamically updated SPA content.",
  "permissions": ["clipboardWrite", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
